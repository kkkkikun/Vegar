# Automatically detect text files
* text=auto

# Explicitly specify text files
*.rs text
*.toml text
*.md text
*.sh text eol=lf
*.py text
*.json text
*.yaml text
*.yml text
*.txt text
*.c text
*.h text
*.cpp text
*.hpp text

# Binary files
*.bin binary
*.elf binary
*.img binary
*.dbg binary
*.swp binary
*.swo binary

# Vendor directory: treat as binary to preserve exact content
vendor/** -text
vendor/ binary
